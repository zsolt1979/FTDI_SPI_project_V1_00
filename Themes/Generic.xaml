  
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:FTDI_SPI_project">

    <Style TargetType="{x:Type local:IndicatorBar}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:IndicatorBar}">
                    <Border Grid.Column="0" Height="170" Width="110" BorderThickness="1" BorderBrush="#FF676767" CornerRadius="5">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="10*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text = "{TemplateBinding IndicatorLabel}" FontSize="12" Foreground="#FFD2D2D2" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2.5*"/>
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel  Grid.Column="0" Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Rectangle x:Name="Signal_0"  Height="11" Width="22" Stroke="Gray" Fill="#FF323232" Margin="1" />
                                    <Rectangle x:Name="Signal_1" Height="11" Width="23" Stroke="Gray" Fill="#FF323232" Margin="1"/>
                                    <Rectangle x:Name="Signal_2" Height="11" Width="25" Stroke="Gray" Fill="#FF323232" Margin="1"/>
                                    <Rectangle x:Name="Signal_3" Height="11" Width="30" Stroke="Gray" Fill="#FF323232" Margin="1"/>
                                    <Rectangle x:Name="Signal_4" Height="11" Width="35" Stroke="Gray" Fill="#FF323232" Margin="1"/>
                                    <Rectangle x:Name="Signal_5" Height="8" Width="40" Stroke="Gray" Fill="#FF323232" Margin="1"/>
                                    <Rectangle x:Name="Signal_6" Height="11" Width="35" Stroke="Gray" Fill="#FF323232" Margin="1"/>
                                    <Rectangle x:Name="Signal_7" Height="11" Width="30" Stroke="Gray" Fill="#FF323232" Margin="1"/>
                                    <Rectangle x:Name="Signal_8" Height="11" Width="25" Stroke="Gray" Fill="#FF323232" Margin="1"/>
                                    <Rectangle x:Name="Signal_9" Height="11" Width="23" Stroke="Gray" Fill="#FF323232" Margin="1"/>
                                    <Rectangle x:Name="Signal_10" Height="11" Width="22" Stroke="Gray" Fill="#FF323232" Margin="1"/>
                                </StackPanel>
                                <Grid Grid.Column="1">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="3*"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text = ">+10" FontSize="15" Foreground="#FFD2D2D2" VerticalAlignment="Center" Margin="-15"/>
                                    <TextBlock Grid.Row="1" Text = "0" FontSize="15" Foreground="#FFD2D2D2" VerticalAlignment="Center"   />
                                    <TextBlock Grid.Row="2" Text = "&lt;-10" FontSize="15" Foreground="#FFD2D2D2" VerticalAlignment="center" Margin="-15"/>
                                </Grid>
                            </Grid>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type local:Angulargauge}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:Angulargauge}">
                    <Grid>
                        <Border BorderThickness="2" Width="170" Height="170" CornerRadius="5">
                            <Canvas Width="150" Height="150" RenderTransformOrigin="0.5,0.5">
                                <Canvas.RenderTransform >
                                    <RotateTransform Angle="{Binding AngularValue, RelativeSource={RelativeSource Mode=TemplatedParent}}"/>
                                </Canvas.RenderTransform>

                                <Ellipse Fill="Transparent" Width="130" Height="130" Stroke="#FF40C0F7" StrokeThickness="3" Canvas.Right="10" Canvas.Bottom="10"/>
                                <Line X1="20" Y1="75" X2="130" Y2="75" StrokeThickness="2" Stroke="#FF676767" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                <Line X1="20" Y1="75" X2="75" Y2="100" StrokeThickness="2" Stroke="#FF676767" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                <Line X1="75" Y1="100" X2="130" Y2="75" StrokeThickness="2" Stroke="#FF676767" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                <TextBlock Width="150" Text="{TemplateBinding AngleLabel}" Foreground="White" Canvas.Top="40" Canvas.Left="0" HorizontalAlignment="Center" TextAlignment="Center" FontSize="20"/>
                            </Canvas>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>